# ---------------------------------------------------------------------------
# Optimum — Ethereum block-propagation latency study
#
# This is a READ-ONLY research pipeline over public Ethereum beacon-chain data.
# It holds no keys, signs nothing, and submits no transactions.
#
# Copy to `.env` and adjust. Every value here is safe to commit except none —
# there are no secrets, by design.
# ---------------------------------------------------------------------------

# Public Xatu parquet root (ethPandaOps). No auth required.
XATU_BASE_URL=https://data.ethpandaops.io/xatu/mainnet/databases/default

# Beacon chain network. Only `mainnet` is meaningful for this study — the
# outcomes we price (staking revenue) only exist on mainnet.
NETWORK=mainnet

# Study window (inclusive). ISO dates.
START_DATE=2025-06-01
END_DATE=2025-06-30

# Local cache for materialised panels. Xatu daily files are ~800MB for
# attestations, so we cache the *aggregated* panel, never the raw parquet.
CACHE_DIR=./data

# DuckDB resources. Raise MEMORY_LIMIT on frankfurt; lower it on a laptop.
DUCKDB_MEMORY_LIMIT=8GB
DUCKDB_THREADS=4

# A slot's block must have been observed by at least this many distinct Xatu
# sentry nodes before we trust its propagation timing. Guards against a single
# badly-clocked sentry driving the arrival estimate.
MIN_SENTRIES=5

# Wild cluster bootstrap replications. 9999 for final runs; 999 while iterating.
BOOTSTRAP_REPS=9999

# RNG seed — the bootstrap and any subsampling must be reproducible.
SEED=20250624

# ETH price, for reporting USD figures only. Does not affect any estimate.
ETH_PRICE_USD=3000
